# Data – never commit the raw dataset
data/
!data/.gitkeep

# Trained models – large binary files stay local
models/
!models/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Jupyter Notebooks (optional)
notebooks/.ipynb_checkpoints/
notebooks/*.ipynb
!notebooks/README.md

# Virtual environment
venv/
env/
ENV/
.venv

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp

# Environment variables
.env
.env.local

# Logs
*.log